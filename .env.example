# ============================================
# BLUE MARKET — Environment Variables
# کپی کن به .env و مقادیر را پر کن
# ============================================

# ---------- محیط ----------
# demo | production
APP_MODE=demo

# ---------- برند ----------
BRAND_NAME_FA="بلو مارکت"
BRAND_NAME_EN="BLUE MARKET"
BRAND_DOMAIN=https://YOUR-DOMAIN.ir
BRAND_PHONE=09229480252
BRAND_EMAIL=mshanbhzhi@gmail.com

# ---------- API (آینده) ----------
# اگر APP_MODE=production، اینجا آدرس بک‌اند را بگذار
API_BASE_URL=
API_TIMEOUT=30000

# ---------- پرداخت (آینده) ----------
# درگاه پرداخت واقعی — فعلاً خالی
PAYMENT_GATEWAY=
PAYMENT_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# ---------- امنیت (آینده) ----------
# JWT secret — فقط سمت سرور، هرگز در فرانت نگذار
# JWT_SECRET=

# ---------- ایمیل/SMS (آینده) ----------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=
SMS_API_KEY=

# ---------- تحلیل ----------
GA_MEASUREMENT_ID=